# Copy to .env.local (or set in Vercel > Project > Settings > Environment Variables).
# The demo form works in development without these. In production at least one
# delivery channel (email or WhatsApp) must be configured, or the form returns an error.

# Email via Resend (https://resend.com)
RESEND_API_KEY=
LEADS_EMAIL_FROM="SchoolGrowth <leads@yourdomain.in>"
LEADS_EMAIL_TO=you@yourdomain.in

# WhatsApp Cloud API (Meta). The number that receives the alert must have
# messaged your business number in the last 24 hours, OR set an approved
# template name below (recommended for production).
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_NOTIFY_TO=91XXXXXXXXXX
WHATSAPP_TEMPLATE=
WHATSAPP_TEMPLATE_LANG=en
WHATSAPP_API_VERSION=v23.0
